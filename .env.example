# ============================================================
# VERCEL ENVIRONMENT VARIABLES — Portfolio Contact
# Set these in Vercel Dashboard > Project > Settings > Environment Variables
# NEVER commit .env to git
# ============================================================

# Gmail address used to SEND emails (authenticated sender)
SMTP_USER=kossayboubaker45@gmail.com

# Gmail App Password — generate at:
# https://myaccount.google.com/apppasswords
# Enable 2FA first, then generate a 16-character App Password
# DO NOT use your regular Gmail password
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Email address that receives recruiter messages
CONTACT_EMAIL=kossayboubaker45@gmail.com
